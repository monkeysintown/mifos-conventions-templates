buildscript {
    repositories {
        mavenLocal()
        mavenCentral().content {
            excludeModule("javax.media", "jai_core")
        }
        gradlePluginPortal()
        maven {
            url = uri("https://central.sonatype.com/repository/maven-snapshots")
        }
        maven {
            url = uri("https://mifos.jfrog.io/artifactory/mifosx-gradle-local")
        }
    }

    dependencies {
        classpath "org.mifos.conventions.gradle:mifos-conventions-gradle-{{projectType}}:0.1.0-SNAPSHOT"
    }
}

{% if projectType == 'boot-imperative' %}
apply plugin: "org.mifos.conventions.gradle.boot.layout"
{% elseif projectType == 'boot-reactive' %}
apply plugin: "org.mifos.conventions.gradle.boot.layout"
{% else %}
apply plugin: "org.mifos.conventions.gradle.base.layout"
{% endif %}

rootProject.name = "{{projectName}}"

mifos {
    project {
        groupId = "{{projectGroupId}}"
        description = "{{projectDescription}}"
        basePackage = "{{projectBasePackage}}"
        inceptionYear = "{{projectInceptionYear}}"
    }
    developers {
        "{{developerUsername}}" {
            firstname = "{{developerFirstname}}"
            lastname = "{{developerLastname}}"
            email = "{{developerEmail}}"
            timezone = "{{developerTimezone}}"
            roles = [{% for role in developerRoles -%}"{{ role }}"{% if not loop.last %},{% endif %}{% endfor -%}]
        }
    }
}
